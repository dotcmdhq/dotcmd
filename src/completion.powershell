# Generated by dotcmd. This adapter queries the launcher being completed.
Register-ArgumentCompleter -Native -CommandName '.cmd' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    function ConvertFrom-DotcmdHex([string] $Text) {
        if ($Text -eq '-') { return '' }
        if ($Text -notmatch '^([0-9a-f]{2})+$') { throw 'Invalid completion field' }
        $bytes = New-Object byte[] ($Text.Length / 2)
        for ($i = 0; $i -lt $bytes.Length; $i++) {
            $bytes[$i] = [Convert]::ToByte($Text.Substring($i * 2, 2), 16)
        }
        [Text.Encoding]::UTF8.GetString($bytes)
    }
    function ConvertTo-DotcmdHex([string] $Text) {
        if ($Text.Length -eq 0) { return '-' }
        [BitConverter]::ToString([Text.Encoding]::UTF8.GetBytes($Text)).Replace('-', '').ToLowerInvariant()
    }
    function Quote-DotcmdCompletion([string] $Text) {
        if ($Text -match '^[\p{L}\p{N}_./:\\=-]+$') { return $Text }
        "'" + $Text.Replace("'", "''") + "'"
    }
    try {
        $first = $commandAst.CommandElements[0]
        if ($first -isnot [System.Management.Automation.Language.StringConstantExpressionAst]) { return }
        $launcher = (Get-Command -Name $first.Value -CommandType Application -ErrorAction Stop).Source
        $length = $cursorPosition - $commandAst.Extent.StartOffset
        $line = $commandAst.Extent.Text
        if ($length -lt $line.Length) { $line = $line.Substring(0, $length) }
        elseif ($length -gt $line.Length) { $line += ' ' * ($length - $line.Length) }
        # Reparse only through the cursor so unfinished quotes and mid-word Tab
        # use PowerShell's own token rules without evaluating expressions.
        $tokens = $null
        $errors = $null
        $parsed = [System.Management.Automation.Language.Parser]::ParseInput($line, [ref]$tokens, [ref]$errors)
        $command = $parsed.Find({ param($node) $node -is [System.Management.Automation.Language.CommandAst] }, $false)
        if (-not $command) { return }
        $previous = @()
        $prefix = ''
        foreach ($element in $command.CommandElements | Select-Object -Skip 1) {
            $value = if ($element -is [System.Management.Automation.Language.StringConstantExpressionAst] -or
                         $element -is [System.Management.Automation.Language.ExpandableStringExpressionAst]) {
                $element.Value
            } else { $element.Extent.Text }
            if ($element.Extent.EndOffset -eq $line.Length) { $prefix = $value }
            else { $previous += ConvertTo-DotcmdHex $value }
        }
        $request = @('--complete', 'words', (ConvertTo-DotcmdHex $prefix)) + $previous
        if ($env:OS -eq 'Windows_NT') {
            $records = & $launcher @request 2>$null
        } else {
            $records = & /bin/sh $launcher @request 2>$null
        }
        foreach ($record in $records) {
            $fields = $record -split "`t"
            if ($fields.Count -ne 3 -or $fields[0] -notlike 'dotcmd:*') { continue }
            $a = ConvertFrom-DotcmdHex $fields[1]
            $b = ConvertFrom-DotcmdHex $fields[2]
            switch ($fields[0]) {
                'dotcmd:value' {
                    $description = if ($b) { $b } else { $a }
                    [System.Management.Automation.CompletionResult]::new(
                        (Quote-DotcmdCompletion $a), $a, 'ParameterValue', $description)
                }
                { $_ -eq 'dotcmd:file' -or $_ -eq 'dotcmd:directory' } {
                    foreach ($item in [System.Management.Automation.CompletionCompleters]::CompleteFilename($b)) {
                        if ($fields[0] -eq 'dotcmd:directory' -and $item.ResultType -ne 'ProviderContainer') { continue }
                        [System.Management.Automation.CompletionResult]::new(
                            ($a + $item.CompletionText), $item.ListItemText, $item.ResultType, $item.ToolTip)
                    }
                }
            }
        }
    } catch {
        # Completion failure must not interrupt the prompt.
    }
}
